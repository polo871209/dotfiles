{
  "general": {
    "launcherShortcut": "cmd+g",
    "showInMenuBar": false,
    "automaticallyCheckForUpdates": false,
    "popToRootSeconds": 90,
    "escapeKeyBehavior": "navigateBackOrClose",
    "autoSwitchInputSource": null
  },
  "appearance": {
    "theme": "system",
    "interfaceSize": "standard",
    "compactMode": false,
    "showFavoritesInCompactMode": true,
    "followCursorAcrossDisplays": true,
    "dragToReposition": false
  },
  "hyperKey": {
    "key": "capsLock",
    "includesShift": true,
    "quickPress": "none",
    "secureInputCompatibility": false
  },
  "calculator": {
    "numberStyle": "system"
  },
  "search": {
    "showsSuggestions": true,
    "sensitivity": "medium"
  },
  "applications": {
    "enabled": true,
    "searchScopes": [
      "/Applications",
      "/Applications/Utilities",
      "/System/Applications",
      "/System/Applications/Utilities",
      "/System/Library/CoreServices/Applications",
      "/System/Volumes/Preboot/Cryptexes/App/System/Applications",
      "/System/Library/CoreServices/Finder.app",
      "~/Applications"
    ],
    "apps": {
      "app.zen-browser.zen": {
        "shortcut": "hyper+space",
        "alias": null,
        "showInLauncher": true
      },
      "com.mitchellh.ghostty": {
        "shortcut": "hyper+j",
        "alias": null,
        "showInLauncher": true
      }
    }
  },
  "systemSettings": {
    "enabled": true,
    "panes": {}
  },
  "systemActions": {
    "enabled": true,
    "actions": {}
  },
  "commands": {
    "builtInEnabled": true,
    "builtIn": {},
    "enabled": false,
    "showInLauncher": true
  },
  "dictation": {
    "mode": "toggle",
    "shortcut": null,
    "model": "redux",
    "microphone": null,
    "destination": "paste",
    "adaptsCapitalization": true,
    "liveInsertion": false,
    "releaseAfterMinutes": 1,
    "language": null
  },
  "notes": {
    "enabled": true,
    "rendersMarkdown": true,
    "showsFormattingBar": true,
    "folder": null,
    "commands": {}
  },
  "navigation": {
    "enabled": true,
    "menuSearchShowsAppleMenu": false,
    "menuSearchDisabledApps": [],
    "windowSwitcherShortcut": "cmd+tab",
    "windowSwitcherExcludedApps": [],
    "commands": {
      "search-menu-items": {
        "shortcut": null,
        "alias": null,
        "showInLauncher": false
      }
    }
  },
  "windowManagement": {
    "enabled": true,
    "showInLauncher": true,
    "gap": 0,
    "cycle": "off",
    "layoutsShowInLauncher": true,
    "roomsShowInLauncher": true,
    "shortcuts": {
      "left-half": "hyper+left",
      "right-half": "hyper+right",
      "top-half": null,
      "bottom-half": null,
      "top-left-quarter": null,
      "top-right-quarter": null,
      "bottom-left-quarter": null,
      "bottom-right-quarter": null,
      "first-three-fourths": null,
      "last-three-fourths": null,
      "first-third": null,
      "center-third": null,
      "last-third": null,
      "first-two-thirds": null,
      "last-two-thirds": null,
      "maximize": "hyper+up",
      "almost-maximize": "hyper+down",
      "reasonable-size": null,
      "maximize-height": null,
      "maximize-width": null,
      "center": null,
      "center-half": null,
      "center-two-thirds": null,
      "make-larger": null,
      "make-smaller": null,
      "restore": null,
      "move-left": null,
      "move-right": null,
      "move-up": null,
      "move-down": null,
      "next-display": null,
      "previous-display": null,
      "toggle-fullscreen": null,
      "previous-space": null,
      "next-space": null
    },
    "aliases": {},
    "customSizes": [],
    "layouts": [],
    "rooms": [],
    "commands": {}
  },
  "clipboard": {
    "enabled": true,
    "retentionDays": 180,
    "defaultAction": "paste",
    "disabledApps": ["com.apple.keychainaccess", "com.apple.Passwords"],
    "commands": {
      "clipboard-history": {
        "shortcut": "cmd+b",
        "alias": null,
        "showInLauncher": true
      }
    }
  },
  "screenshot": {
    "saveFolder": "~/Downloads",
    "commands": {
      "capture-screenshot": {
        "shortcut": "hyper+x",
        "alias": null,
        "showInLauncher": true
      }
    }
  },
  "emoji": {
    "skinTone": "none",
    "gridColumns": 8,
    "commands": {}
  }
}
