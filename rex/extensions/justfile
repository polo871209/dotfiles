app := "/Applications/Rex Beta.app"
support := env("HOME") / "Library/Application Support/rex-extensions"
label := "local.rex-extensions"
agent := env("HOME") / "Library/LaunchAgents" / label + ".plist"

# Build and install the extensions, patch Rex, start a launch agent that patches Rex again after each Rex update, reload init.lua, and reopen Rex
patch:
    #!/bin/sh
    set -eu
    swift build -c release
    mkdir -p "{{ support }}"
    # A new inode, so a running Rex keeps the dylib it mapped.
    install -m 755 .build/release/libRexExtensions.dylib "{{ support }}/RexExtensions.dylib.new"
    mv -f "{{ support }}/RexExtensions.dylib.new" "{{ support }}/RexExtensions.dylib"
    install -m 755 .build/release/insert-dylib patch-rex "{{ support }}/"
    "{{ support }}/patch-rex"
    launchctl bootout "gui/$(id -u)/{{ label }}" 2>/dev/null || true
    cat > "{{ agent }}" <<EOF
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
        <key>Label</key><string>{{ label }}</string>
        <key>ProgramArguments</key><array><string>{{ support }}/patch-rex</string></array>
        <key>WatchPaths</key><array><string>/Applications</string></array>
        <key>StartInterval</key><integer>600</integer>
        <key>StandardOutPath</key><string>{{ env("HOME") }}/Library/Logs/rex-extensions.log</string>
        <key>StandardErrorPath</key><string>{{ env("HOME") }}/Library/Logs/rex-extensions.log</string>
    </dict>
    </plist>
    EOF
    plutil -lint -s "{{ agent }}"
    launchctl bootstrap "gui/$(id -u)" "{{ agent }}"
    "$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex" config reload
    # Panes belong to the Rex server, so quitting the app keeps them and this shell.
    pgrep -xq Rex || exit 0
    osascript -e 'tell application id "com.superlogical.rex" to quit'
    for _ in $(seq 50); do pgrep -xq Rex || break; sleep 0.2; done
    pgrep -xq Rex && { echo "Rex did not quit. Quit it (⌘Q) and open it again." >&2; exit 1; }
    open "{{ app }}"

# Stop the launch agent and put the official Rex back
unpatch:
    #!/bin/sh
    set -eu
    launchctl bootout "gui/$(id -u)/{{ label }}" 2>/dev/null || true
    rm -f "{{ agent }}"
    test -d "{{ support }}/official/Rex Beta.app" || { echo "no official backup in {{ support }}/official" >&2; exit 1; }
    rm -rf "{{ support }}/replaced"
    mkdir -p "{{ support }}/replaced"
    mv "{{ app }}" "{{ support }}/replaced/"
    ditto "{{ support }}/official/Rex Beta.app" "{{ app }}"
    echo "Official Rex restored. Quit Rex (⌘Q) and open it again."

# Run the Swift tests
test:
    swift test
