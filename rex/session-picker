#!/usr/bin/env bash
# Usage: session-picker [CLIENT_ID [SESSION_ID]]. Lists Rex sessions, their agents, and zoxide directories, then shows the pick in the Rex app.
# shellcheck disable=SC1010 # `rex do` is a subcommand, not a shell loop.
set -euo pipefail
trap 'read -r -p "Press Enter to close. "' ERR

client=${1:-$(rex client ls --json | jq -r 'first(.clients[] | select(.info.kind == "app")) | .client_id')}
current=${2:-$REX_SESSION}
rows=(rex do "${0%/*}/session-rows.lua" current="$current")

pick=$(
  "${rows[@]}" | fzf --delimiter '\t' --with-nth 4 --ansi --no-sort --layout reverse --color 16 \
    --header 'ctrl-x: kill session' \
    --bind "ctrl-x:execute-silent([[ {1} == session && {2} != $(printf %q "$current") ]] && rex kill {2})+reload($(printf '%q ' "${rows[@]}"))"
) || exit 0

IFS=$'\t' read -r kind target block _ <<<"$pick"
case $kind in
  dir) rex -C "$client" do session_open dir="$target" from="$current" >/dev/null ;;
  session) rex -C "$client" do session_switch session_id="$target" from="$current" >/dev/null ;;
  agent) rex -C "$client" do session_switch session_id="$target" block_id="$block" from="$current" >/dev/null ;;
esac
