shiki := "4.5.0"
esbuild := "0.28.2"
mermaid := "12.0.0"
firacode := "6.2.0"
slugger := "2.0.0"

vendor := "Sources/mdview/Resources/vendor"
cdn := "https://cdn.jsdelivr.net/npm"

# Download the assets and build the release binary that nvim runs
build: vendor
    swift build -c release

# Download the pinned assets and bundle Shiki into the git-ignored vendor directory
vendor:
    mkdir -p {{ vendor }}
    npm install --silent --no-save --prefix .build/shiki shiki@{{ shiki }} esbuild@{{ esbuild }}
    rm -rf {{ vendor }}/shiki
    cd .build/shiki && node_modules/.bin/esbuild shiki --bundle --splitting --format=esm --minify --log-level=warning --entry-names=shiki '--chunk-names=[hash]' --outdir=../../{{ vendor }}/shiki
    curl -fsSLo {{ vendor }}/mermaid.min.js {{ cdn }}/mermaid@{{ mermaid }}/dist/mermaid.min.js
    curl -fsSLo {{ vendor }}/FiraCode-VF.woff2 {{ cdn }}/firacode@{{ firacode }}/distr/woff2/FiraCode-VF.woff2
    curl -fsSLo {{ vendor }}/github-slugger.js {{ cdn }}/github-slugger@{{ slugger }}/+esm

# Run the Swift tests
test: vendor
    swift test
