[user]
	name = PoLo
	email = qazh0123@gmail.com

[core]
	editor = nvim
	autocrlf = input
	filemode = false
	quotepath = false
	excludesFile = ~/.config/git/ignore

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[worktree]
	useRelativePaths = true

[merge]
	conflictstyle = zdiff3

[rebase]
	autoStash = true
	autoSquash = true

[rerere]
	enabled = true
	autoupdate = true

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

[column]
	ui = auto

[log]
	date = iso

[diff]
	algorithm = histogram

[help]
	autocorrect = prompt

[url "git@github.com:"]
	insteadOf = https://github.com/
[url "git@github.com-qashier:qashierpos/"]
	insteadOf = git@github.com:qashierpos/
[includeIf "gitdir:~/workspace/"]
	path = qashier
